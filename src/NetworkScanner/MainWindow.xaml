<Window x:Class="NetworkScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NetworkScanner"
        Title="Network Scanner" Icon="Assets/app.ico" Width="1320" Height="820" MinWidth="1040" MinHeight="600"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{DynamicResource TextBrush}" Background="{DynamicResource WindowBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:InvertedBoolToVisibility x:Key="NotBoolToVisibility" />

        <DataTemplate x:Key="Tile">
            <Grid Width="32" Height="32">
                <Border CornerRadius="8" Background="{Binding TileFill}">
                    <TextBlock Style="{StaticResource Icon}" FontSize="15" HorizontalAlignment="Center"
                               Text="{Binding Glyph}" Foreground="{Binding TileFore}" />
                </Border>
                <Ellipse Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0"
                         Fill="{DynamicResource OnlineBrush}" Stroke="{DynamicResource PanelBrush}" StrokeThickness="2"
                         Visibility="{Binding Online, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="Tag" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,1,8,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Stat" TargetType="StackPanel">
            <Setter Property="Margin" Value="18,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StatNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border BorderBrush="{DynamicResource RowLineBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel>
                <Button DockPanel.Dock="Right" MinWidth="84" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource AccentButton}"
                        Content="{Binding ScanButtonText}" Command="{Binding ScanCommand}" />
                <Button DockPanel.Dock="Right" MinWidth="64" Margin="22,0,0,0" VerticalAlignment="Center" Style="{StaticResource QuietButton}"
                        Content="{Binding ThemeButtonText}" Command="{Binding ToggleThemeCommand}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <StackPanel Style="{StaticResource Stat}">
                        <TextBlock Style="{StaticResource StatNumber}" Text="{Binding DeviceCount}" />
                        <TextBlock Style="{StaticResource StatLabel}" Text="devices" />
                    </StackPanel>
                    <Rectangle Width="1" Margin="18,4,0,4" Fill="{DynamicResource BorderBrush}" />
                    <StackPanel Style="{StaticResource Stat}">
                        <TextBlock Style="{StaticResource StatNumber}" Foreground="{DynamicResource OnlineBrush}" Text="{Binding OnlineCount}" />
                        <TextBlock Style="{StaticResource StatLabel}" Text="online" />
                    </StackPanel>
                    <Rectangle Width="1" Margin="18,4,0,4" Fill="{DynamicResource BorderBrush}" />
                    <StackPanel Style="{StaticResource Stat}">
                        <TextBlock Style="{StaticResource StatNumber}" Text="{Binding UpstreamCount}" />
                        <TextBlock Style="{StaticResource StatLabel}" Text="routers upstream" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="10" Margin="0,0,14,0" Background="{DynamicResource AccentSoftBrush}">
                        <TextBlock Style="{StaticResource Icon}" FontSize="20" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}" Text="{x:Static local:DeviceIcons.RouterGlyph}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding NetworkTitle}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding NetworkText}" Style="{StaticResource Secondary}" FontSize="12" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <ProgressBar Grid.Row="1" Height="2" MinHeight="2" Maximum="1" Value="{Binding Progress}" BorderThickness="0"
                     Background="Transparent" Foreground="{DynamicResource AccentBrush}"
                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />

        <Grid Grid.Row="2" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="700" MinWidth="420" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Panel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Margin="14,10" Text="{Binding StatusText}" Style="{StaticResource Secondary}" />
                    <ListView x:Name="DeviceList" Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ItemsSource="{Binding Devices}" SelectedItem="{Binding Selected}"
                              ItemContainerStyle="{StaticResource DeviceRow}"
                              GridViewColumnHeader.Click="OnHeaderClick">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource DeviceHeader}">
                                <GridViewColumn Header="Device" Width="230">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="4,0,0,0" Opacity="{Binding RowOpacity}">
                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Tile}" Margin="0,0,12,0" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Secondary}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="170"
                                                               Visibility="{Binding Subtitle, Converter={x:Static local:NullToVisibility.WhenNotNull}}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="IP" Width="116">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Ip}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="Normal" Opacity="{Binding RowOpacity}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="MAC" Width="142">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Mac}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="Normal"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" Opacity="{Binding RowOpacity}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Type" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Tag}" Background="{Binding TileFill}" Opacity="{Binding RowOpacity}">
                                                <TextBlock Text="{Binding KindText}" FontSize="11" Foreground="{Binding TileFore}" />
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Last seen" Width="92">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LastSeen}" Opacity="{Binding RowOpacity}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" Background="Transparent" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Panel}" ClipToBounds="True">
                    <local:NetworkMap ItemsSource="{Binding Devices}" SelectedItem="{Binding Selected}" UpstreamRouters="{Binding UpstreamRouters}" />
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="16,14" MinHeight="168">
                    <Grid>
                        <TextBlock Text="Select a device to see its details." Style="{StaticResource Secondary}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Visibility="{Binding Selected, Converter={x:Static local:NullToVisibility.WhenNull}}" />

                        <Grid Visibility="{Binding Selected, Converter={x:Static local:NullToVisibility.WhenNotNull}}">
                            <Grid Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NotBoolToVisibility}}" DataContext="{Binding Selected}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DockPanel Margin="0,0,0,14">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Style="{StaticResource QuietButton}" Content="Edit" Margin="0,0,8,0"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Button Style="{StaticResource QuietButton}" Content="Forget"
                                                Command="{Binding DataContext.ForgetCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </StackPanel>
                                    <Border Width="46" Height="46" CornerRadius="11" Background="{Binding TileFill}" Margin="0,0,14,0">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="22" HorizontalAlignment="Center"
                                                   Text="{Binding Glyph}" Foreground="{Binding TileFore}" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Border Style="{StaticResource Tag}" Background="{Binding TileFill}" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding KindText}" FontSize="11" Foreground="{Binding TileFore}" />
                                            </Border>
                                            <Border>
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource Tag}">
                                                        <Setter Property="Background" Value="{DynamicResource OfflineSoftBrush}" />
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Online}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource OnlineSoftBrush}" />
                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource OnlineBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusTag}" FontSize="11" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Margin" Value="0,2,16,2" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        </Style>
                                        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                        </Style>
                                        <Style x:Key="Mono" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                                        </Style>
                                    </Grid.Resources>

                                    <TextBlock Text="IP" Style="{StaticResource Label}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Ip}" Style="{StaticResource Mono}" />
                                    <TextBlock Grid.Column="2" Text="First seen" Style="{StaticResource Label}" />
                                    <TextBlock Grid.Column="3" Text="{Binding FirstSeen}" />

                                    <TextBlock Grid.Row="1" Text="MAC" Style="{StaticResource Label}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Mac}" Style="{StaticResource Mono}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Last seen" Style="{StaticResource Label}" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding LastSeen}" />

                                    <TextBlock Grid.Row="2" Text="Vendor" Style="{StaticResource Label}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding FullVendor}" ToolTip="{Binding FullVendor}" />
                                </Grid>
                            </Grid>

                            <Grid Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MaxWidth="320" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Name" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,12,8" />
                                <TextBox Grid.Column="1" Margin="0,0,0,8" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Leave empty to use the automatic name" />
                                <TextBlock Grid.Row="1" Text="Type" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,12,8" />
                                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" ItemsSource="{Binding EditKinds}"
                                          SelectedItem="{Binding EditKind}" DisplayMemberPath="Label" IsEnabled="{Binding CanEditKind}" />
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Style="{StaticResource AccentButton}" Content="Save" Margin="0,0,8,0" IsDefault="True" Command="{Binding SaveEditCommand}" />
                                    <Button Style="{StaticResource QuietButton}" Content="Cancel" IsCancel="True" Command="{Binding CancelEditCommand}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
